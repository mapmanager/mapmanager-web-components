{
  "name": "@mapmanager/signal-viewer",
  "version": "0.1.0",
  "private": true,
  "description": "Reusable range-loaded scientific signal viewer.",
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mapmanager/mapmanager-web-components.git",
    "directory": "packages/signal-viewer"
  },
  "type": "module",
  "files": ["dist-lib", "dist-element", "README.md"],
  "types": "./dist-lib/types/public-api.d.ts",
  "module": "./dist-lib/signal-viewer-web.js",
  "exports": {
    ".": {
      "types": "./dist-lib/types/public-api.d.ts",
      "import": "./dist-lib/signal-viewer-web.js"
    },
    "./register": "./dist-element/signal-viewer-element.js",
    "./style.css": "./dist-lib/signal-viewer-web.css"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && npm run build:app && npm run build:lib && npm run build:element",
    "build:app": "vite build",
    "build:lib": "vite build --config vite.lib.config.ts && npm run build:types",
    "build:types": "vue-tsc --project tsconfig.build.json --declaration --emitDeclarationOnly --noEmit false",
    "build:element": "vite build --config vite.element.config.ts",
    "test": "vitest run",
    "typecheck": "vue-tsc --build --force"
  },
  "dependencies": {
    "uplot": "^1.6.32",
    "vue": "^3.5.41"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/tsconfig": "^0.9.1",
    "typescript": "^6.0.3",
    "vite": "^8.2.1",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.9"
  }
}
